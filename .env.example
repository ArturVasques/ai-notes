# LOCAL DEVELOPMENT TEMPLATE. Copy to .env for your laptop only.
# Production never reads a .env file: every value below is injected by the
# deployment platform with APP_ENV=production. See README.md "Environments".

# Application
# Required. One of: development, test, production. No default is provided
# on purpose: an unset APP_ENV must fail application startup instead of
# silently falling back to a permissive mode. Development header
# authentication (X-User-Id / X-Tenant-Id) is only ever active when this is
# exactly "development".
APP_ENV=development
LOG_LEVEL=INFO

# Comma-separated list of allowed CORS origins, e.g.
# "http://localhost:4200,https://app.example.com". Empty disables CORS.
CORS_ALLOWED_ORIGINS=

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
# Must be a key of EMBEDDING_MODEL_DIMENSIONS in app/core/config.py whose
# dimension matches the document_chunks.embedding column (VECTOR(1536)).
# Changing this to a model with a different dimension requires a schema
# migration and re-embedding every existing document chunk.
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=ai_workspace_production
POSTGRES_USER=postgres
POSTGRES_PASSWORD=

# RAG
RAG_TOP_K=5
RAG_MAX_DISTANCE=0.8