# LOCAL DEVELOPMENT TEMPLATE. Copy to .env for your laptop only.
# Production never reads a .env file: every value below is injected by the
# deployment platform with APP_ENV=production. See README.md "Environments".

# Application
# Required. One of: development, test, production. No default is provided
# on purpose: an unset APP_ENV must fail application startup instead of
# silently falling back to a permissive mode.
APP_ENV=development
LOG_LEVEL=INFO

# Comma-separated list of allowed CORS origins, e.g.
# "http://localhost:4200,https://app.example.com". Empty disables CORS.
CORS_ALLOWED_ORIGINS=

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=personal_finance
POSTGRES_USER=postgres
POSTGRES_PASSWORD=

# Microsoft Entra ID. Public identifiers, not secrets: the API validates
# access tokens (v2) issued by this tenant for this API app registration
# and never needs a client secret.
# ENTRA_TENANT_ID: Directory (tenant) ID.
# ENTRA_API_CLIENT_ID: Application (client) ID of the API registration; it
# is the expected `aud` claim.
# ENTRA_REQUIRED_SCOPE: delegated scope the token must carry (`scp`).
ENTRA_TENANT_ID=
ENTRA_API_CLIENT_ID=
ENTRA_REQUIRED_SCOPE=access_as_user
